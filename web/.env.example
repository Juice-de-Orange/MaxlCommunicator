# Copy to .env and fill in. .env is gitignored; CLAUDE.md 6 -- no secrets in the
# repository.

# Local development against `docker compose up -d postgres`. Use the same
# password in both lines. Generate one with: openssl rand -hex 16
DATABASE_URL=postgres://maxl:change-me@127.0.0.1:5433/maxl

POSTGRES_USER=maxl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maxl
POSTGRES_PORT=5433
WEB_PORT=4321

# The dashboard is one person and two nodes, so it is one password rather than a
# user table. Generate with: openssl rand -base64 24
DASHBOARD_PASSWORD=

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# The public host name of the dashboard when it runs behind a TLS-terminating
# reverse proxy (docs/DEPLOYMENT.md 3), e.g. maxl.example.com -- without it the
# login form is refused with 403 there. Leave empty for http://localhost.
# Built into the server: after changing it, `docker compose up -d --build`
# (or `npm run build` locally).
DASHBOARD_HOST=

# Device ingest tokens are NOT set here. They are generated per device with
# `npm run device:add`, and only their hash is stored -- see
# CLAUDE.md 4.3: the ingestion endpoint authenticates a device-bridge pair, not
# a web session.
