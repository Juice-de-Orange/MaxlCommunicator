---
/*
 * Page shell. Server-rendered on every request -- there is nothing to prerender
 * when the whole point is a live event log.
 */
import "../styles/global.css";

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: "/", label: "Nodes" },
  { href: "/messages", label: "Messages" },
  { href: "/radio", label: "Radio" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — MaxlCommunicator</title>
  </head>
  <body class="min-h-screen bg-plane text-ink antialiased">
    <header class="border-b border-hairline bg-surface">
      <div class="mx-auto flex max-w-6xl flex-wrap items-baseline gap-x-8 gap-y-2 px-6 py-4">
        <a href="/" class="text-sm font-semibold tracking-tight">MaxlCommunicator</a>
        <nav class="flex gap-6 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "transition-colors hover:text-ink",
                  path === item.href ? "text-ink font-medium" : "text-ink-secondary",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <form method="post" action="/api/logout" class="ml-auto">
          <button class="text-sm text-ink-muted transition-colors hover:text-ink">Sign out</button>
        </form>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-8">
      <div class="mb-8">
        <h1 class="text-2xl font-semibold tracking-tight">{title}</h1>
        {subtitle && <p class="mt-1 text-sm text-ink-secondary">{subtitle}</p>}
      </div>
      <slot />
    </main>
  </body>
</html>
