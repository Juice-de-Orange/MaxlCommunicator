{
  "name": "maxl-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Management dashboard for the MaxlCommunicator LoRa network. Append-only event log; all state is a projection.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "device:add": "tsx scripts/device.ts add",
    "device:list": "tsx scripts/device.ts list",
    "device:rotate": "tsx scripts/device.ts rotate",
    "seed": "tsx scripts/seed.ts",
    "build:pwa": "cd ../bridge && npm run build && cd ../web && rm -rf public/app && mkdir -p public && cp -r ../bridge/dist public/app",
    "build:all": "npm run build:pwa && npm run build"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@astrojs/react": "6.0.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "typescript": "5.7.2",
    "vitest": "^4.1.11"
  }
}
